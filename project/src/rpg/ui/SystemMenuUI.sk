//	コンフィグ設定のための機能実装。
//	ラベルの設定、選択時の挙動
local confirmConfigChange(){
	return RPGMain.showUI( {
		key = "dialog_confirm"
		msg = "변경하시겠습니까?"
		text0 = "예"
		text1 = "아니오"
	});
}

local hasConnectedGamepad(){
	if( !::["gpui"]) return false;
	local gp = ::gpui["gamepad"];
	return !!(gp && gp["connected"]);
}

local confimplmap = {
	choice = {
		binds = @( conf){
			local list = fget( conf, "list");
			local fn(){
				local val = fget( conf, "get") ?? ::getField( ::clientconf, conf.pid);
				return rtf( list.find( @( v) v.val==val)["lbl"] || "？");
			}
			return { key=conf.lbl, mode=0, lbl=fn, _name=conf.pid.replace( ".", "_"), conf=conf};
		},
		action = @( iv, conf){
			local list = fget( conf, "list");
			local val = fget( conf, "get") ?? ::getField( ::clientconf, conf.pid);
			local idx = list.findi( @( v) v.val==val);
			if( idx < 0) idx = 0;
			local sel = RPGMain.showUI( {
				key = "dialog_choices"
				uipath = "dialog_choices2.ui"
				list = list.map( @( v) v.lbl)		//	選択肢ダイアログはstring[]のみ
				place = iv
				backop = 2
				pos = { left=-14, right=-14 }
				focus = "item"..idx
			});
			if( sel >= 0){
				if( list[sel].val==val) return false;
				if( !confirmConfigChange()) return false;
				if( conf["set"]){
					return conf.set( list[sel].val);
				}else{
					::setField( ::clientconf, conf.pid, list[sel].val);
					return true;
				}
			}
		},
	},
	keybind = {
		binds = @( conf){
			local keyname( list, val, fallback){
				local item = list.find( @( v) v.val==val);
				return item ? item.lbl : fallback..val;
			}
			local fn = @(){
				local keyboard = "키보드 : "..keyname( conf.keylist, conf.getkey(), "Key ");
				local gamepad = hasConnectedGamepad()
					? "게임패드 : "..keyname( conf.padlist, conf.getpad(), "Button ")
					: "게임패드 : 연결 안 됨";
				// configitem.ui의 오른쪽 값 영역에 두 입력 필드를 나란히 표시한다.
				// RichText의 [] 태그 파서와 충돌하지 않도록 일반 문자열로 반환한다.
				return keyboard.."        "..gamepad;
			};
			return { key=conf.lbl, mode=0, lbl=fn, _name="keybind_"..conf.action, conf=conf};
		},
		action = @( iv, conf){
			local gamepadavailable = hasConnectedGamepad();
			local device = RPGMain.showUI( {
				key = "dialog_choices"
				uipath = "dialog_choices2.ui"
				list = gamepadavailable ? ["키보드", "게임패드"] : ["키보드"]
				place = iv
				backop = 2
				pos = { left=-14, right=-14 }
				focus = "item0"
			});
			if( device < 0) return false;
			local oldc = gpui.backupCursor();
			local result = ptr( null);
			local capturetime = skGetTime() + 250;
			local keyevent = @( e){
				if( e.id!=KEY_PRESSED) return;
				if( skGetTime()<capturetime) return;
				if( device==0){
					result << e.keycode;
					e.consume();
				}else if( e.keycode==VK_ESCAPE){
					result << -1;
					e.consume();
				}
			};
			::rootview.addPostEventListener( KEY_EVENT, keyevent);

			local view = RPGMain.showView({
				uipath = "dialog_confirm.ui"
				layer = "message"
				action = "show"
				modal = true
				place = iv
				binds = {
					msg = RichText( device==0
						? "설정할 키보드 키를 눌러 주세요."
						: "설정할 게임패드 버튼을 눌러 주세요.\n[+0](Esc: 취소)")
					LIST = [{ lbl="입력을 기다리는 중…", _name="item0", idx=0 }]
				}
				focus = "item0"
			});
			local padready = ptr( false);
			RPGMain.uiLoop( {
				"action" : @( e){},
				"back" : @( e){},
				"idle" : @( e){
					if( ~result!=null) return ~result;
					if( device==1){
						if( !hasConnectedGamepad()){
							result << -1;
							return -1;
						}
						local gpdev = ::gpui.getGPUIDevice();
						local gp = gpdev ? fget( gpdev, "gp") : null;
						local mask = gp ? gp.buttonmask : 0;
						if( !~padready){
							if( mask==0) padready << true;
						}else if( mask){
							for( local i=0;i<32;i++){
								if( mask & (1<<i)){
									result << i;
									return i;
								}
							}
						}
					}
				},
			});
			::rootview.removeEventListener( KEY_EVENT, keyevent);
			view.actionAndDie( "hide");
			view.waitAction();
			gpui.restoreCursor( oldc);

			local val = ~result;
			if( val==null || val<0) return false;
			local oldval = device==0 ? conf.getkey() : conf.getpad();
			if( val==oldval) return false;
			if( !confirmConfigChange()) return false;
			return device==0 ? conf.setkey( val) : conf.setpad( val);
		},
	},
	slider = {
		binds = @( conf){
			return { key=conf.lbl, mode=1, 
				bar=@() (::getField( ::clientconf, conf.pid)-conf.range[0]) * 10.0 / (conf.range[1]-conf.range[0]),
				val=@() string( ::getField( ::clientconf, conf.pid)), 
				_name=conf.pid, conf=conf
			};
		}
		action = @( iv, conf){
			local oldc = gpui.backupCursor();
			playSound( "SE005");
			local oldval = ::getField( ::clientconf, conf.pid) || 0;
			local vptr = ptr( oldval);
			local view = RPGMain.showView({
				uipath = "menu_config_slider.ui"
				name = "menu_config_slider"
				layer = "message"
				modal = true,
				place = iv
				binds = {
					bar=@() (~vptr-conf.range[0]) * 10.0 / (conf.range[1]-conf.range[0]),
					val=@() string( ~vptr), 
				},
				action = "show"
			});
			local delta = {[BTN_LEFT]=-1, [BTN_RIGHT]=1, [BTN_UP]=10, [BTN_DOWN]=-10, "dec"=-1, "inc"=1 }
			local r = RPGMain.uiLoop( {
				"action" : @( e){
					local d = delta[e.name];
					if( d){
						local v = Math.clamp( ~vptr+d, conf.range[0], conf.range[1]);
						vptr << v;
						playSound( "SE000");
						//
						if( conf["set"]){
							conf.set( v);
						}else{
							::setField( ::clientconf, conf.pid, v);
						}
					}
				}
				"click" : @( e){
					if( !e["ismouse"]) return "ok";
				}
				"back" : @( e){
					return e["ismouse"] ? "ok" : "back";
				}
				"curs" : @( e){
					local d = delta[e.keycode];
					if( d){
						local v = Math.clamp( ~vptr+d, conf.range[0], conf.range[1]);
						vptr << v;
						playSound( "SE000");
						//
						if( conf["set"]){
							conf.set( v);
						}else{
							::setField( ::clientconf, conf.pid, v);
						}
					}
				}
			});
			playSound( "SE001");
			view.actionAndDie( "hide").waitAction();
			gpui.restoreCursor( oldc);
			local newval = ~vptr;
			if( newval==oldval) return false;
			if( confirmConfigChange()) return true;
			if( conf["set"]){
				conf.set( oldval);
			}else{
				::setField( ::clientconf, conf.pid, oldval);
			}
			return false;
		}
	},
}

local keyboardkeylist = [
	{lbl="↑",val=VK_UP}, {lbl="↓",val=VK_DOWN}, {lbl="←",val=VK_LEFT}, {lbl="→",val=VK_RIGHT},
	{lbl="W",val=VK_W}, {lbl="A",val=VK_A}, {lbl="S",val=VK_S}, {lbl="D",val=VK_D},
	{lbl="Q",val=VK_Q}, {lbl="E",val=VK_E}, {lbl="Z",val=VK_Z}, {lbl="X",val=VK_X},
	{lbl="C",val=VK_C}, {lbl="V",val=VK_V}, {lbl="Space",val=VK_SPACE},
	{lbl="Enter",val=VK_ENTER}, {lbl="Esc",val=VK_ESCAPE}, {lbl="Tab",val=VK_TAB},
	{lbl="Shift",val=VK_SHIFT}, {lbl="Ctrl",val=VK_CONTROL},
];
local gamepadkeylist = [
	{lbl="D-Pad ↑",val=BTN_UP}, {lbl="D-Pad ↓",val=BTN_DOWN},
	{lbl="D-Pad ←",val=BTN_LEFT}, {lbl="D-Pad →",val=BTN_RIGHT},
	{lbl="A",val=BTN_A}, {lbl="B",val=BTN_B}, {lbl="X",val=BTN_X}, {lbl="Y",val=BTN_Y},
	{lbl="LB",val=BTN_LB}, {lbl="RB",val=BTN_RB},
	{lbl="LT",val=BTN_ZL}, {lbl="RT",val=BTN_ZR},
	{lbl="L Stick",val=BTN_LS}, {lbl="R Stick",val=BTN_RS},
	{lbl="Start",val=BTN_START},
];
local actionvbmap = {
	move_up=BTN_UP, move_down=BTN_DOWN, move_left=BTN_LEFT, move_right=BTN_RIGHT,
	confirm=BTN_A, cancel=BTN_B, menu=BTN_X, subaction=BTN_Y,
	page_left=BTN_LB, page_right=BTN_RB, start=BTN_START,
};
local refreshPlayerControls(){
	if( !::["rpgstage"] || !::rpgstage["player3d"]) return;
	local action = ::rpgstage.player3d["mainaction"];
	local ctr = action ? action["ctr"] : null;
	if( !ctr) return;
	local active = ctr.active;
	ctr.setup();
	ctr.active = !active;
	ctr.setActive( active);
}
local setkeybind( action, val){
	::clientconf.keyboard_action[action] = val;
	local vb = fget( actionvbmap, action);
	if( vb!=undefined) ::clientconf.keyboard_menu[vb] <- [val];
	if( ::["gpui"]){
		local bkmap = { ...ClientConfig.def_keybtnmap, ...::clientconf.keyboard_menu};
		::gpui.setButtonKeyMap( bkmap);
	}
	refreshPlayerControls();
	return true;
}
local setpadbind( action, val){
	::clientconf.gamepad_action[action] = val;
	local vb = fget( actionvbmap, action);
	if( vb!=undefined) ::clientconf.gamepad_menu[vb] <- val;
	if( ::["gpui"]) ::gpui.setButtonGamepadMap( ::clientconf.gamepad_menu);
	refreshPlayerControls();
	return true;
}
local keybindconf( action, lbl){
	return {
		type="keybind", action=action, lbl=lbl,
		desc="왼쪽은 키보드, 오른쪽은 게임패드 설정입니다.",
		keylist=keyboardkeylist, padlist=gamepadkeylist,
		getkey=@() ::clientconf.keyboard_action[action],
		getpad=@() ::clientconf.gamepad_action[action],
		setkey=@( val) setkeybind( action, val),
		setpad=@( val) setpadbind( action, val),
	};
}
local keybindconfs = [
	keybindconf("move_up", "이동 위"),
	keybindconf("move_down", "이동 아래"),
	keybindconf("move_left", "이동 왼쪽"),
	keybindconf("move_right", "이동 오른쪽"),
	keybindconf("confirm", "결정 / 상호작용"),
	keybindconf("cancel", "취소 / 점프"),
	keybindconf("menu", "메뉴"),
	keybindconf("subaction", "보조 액션"),
	keybindconf("page_left", "이전 탭"),
	keybindconf("page_right", "다음 탭"),
	keybindconf("start", "시작 / 일시정지"),
	keybindconf("lockon", "락온"),
	keybindconf("dodge", "회피"),
	keybindconf("burst", "버스트"),
];


RPGSystem.ui ..
{
	key = "menu_config"
	lbl = "$T.config"
	type = "submenu"		//	mainmanu, submenu, choose, dialog, message, info, debug, misc, 
	topinfo = "$T.config"
	icon = "\ue30a"

	configtabs = [
		{ lbl="$T.config_game", list=[ cmdconf, battlespdconf, btnhelpconf, bgmvolconf, sevolconf, langconf], }
		{ lbl="$T.config_video", list=[ fullconf, winresoconf, scresoconf, quaconf, ], }
		{ lbl="키 설정", list=keybindconfs, }
	];

	props = [
	],

	defval = {
	}

	function uifunc( prms){
		local tabs = configtabs, tn = length( tabs);
		local tabptr = ptr( 0);		//	アイテム、武器、防具、キーアイテム。
		local changed = false;
		//	コンフィグ項目リストを作成
		local makelist( tab) fget( tab, "list").map( @( v, i){
			if( fget( v, "disable")) return undefined;
			local impl = confimplmap[v.type];
			return impl.binds( v);
		});
		local list0 = makelist( tabs[0]);
		//
		local view = RPGMain.showView({
			uipath = "menu_config.ui"
			name = "menu_config"
			layer = "menu"
			binds = {
				tablist = tabs.map( @( v, i)({
					_name = "tab"..i,
					lbl = v.lbl,
					tgl = @() (i==~tabptr)?10:0,
					tab = v,
				})),
				itemlist = list0,
			},
			action = "show"
			focus = list0[0]["_name"] .. ".btn";
		});
		local remakelist(){
			view.setValue( "itemlist", makelist( tabs[~tabptr]));
		}
	BACK_TO_ITEMSEL:
		//	使用可能なアイテムを選択
		local inctab( d){ tabptr << ((~tabptr+d+tn) % tn); remakelist(); }
		local ev = RPGMain.uiLoop( {
			"action" : @( e){	//	スロット、最強装備、すべて外すが来る
				switch( e.name){
				case "tabinc": inctab( 1); playSound( "SE000"); break;
				case "tabdec": inctab( -1); playSound( "SE000"); break;
				case "tab0": case "tab1": case "tab2": case "tab3": 
					tabptr << (e.name[3]-'0');
					remakelist();
					break;
				default:
					if( e.item["conf"]) return e;
					break;
				}
			}
			"page" : @( e){
				inctab( e.count);
				playSound( "SE000");
			}
			"select" : @( e){	//	選択時に説明表示
				if( e.item["conf"]){
					view.setValue( "desclbl", ::rtf( compiletemplate_c( e.item.conf["desc"]||"")()) );	//	desclblはテンプレートを自動で展開しない。。。
				}
			}
			"back" : @( e){ return "back"; }
		});
		if( ev == "back"){
			view.actionAndDie( "hide");//.waitAction();
			playSound( "SE004");
			ClientConfig.save();
			return true;
		}
		//	
		local conf = ev.item.conf;
		local impl = confimplmap[conf.type];
		view.action( "darken");
		if( impl.action( ev.src, conf)){
			changed = true;
			if( conf["refresh"]) remakelist();
		}
		view.action( "lighten");
		
		goto BACK_TO_ITEMSEL;
	}
};


RPGSystem.ui ..
{
	key = "menu_exitgame"
	lbl = "$T.exitgame"
	type = "submenu"		//	mainmanu, submenu, choose, dialog, message, info, debug, misc, 
	nochange_menuui = true
	topinfo = "$T.exitgame"
	icon = "\ue30a"

	props = [
	],

	defval = {
	}

	function uifunc( prms){
		local menu_main = ::rootview.findChild( "menu_main");
		menu_main?.action( "darken");
		local ret = RPGMain.showUI( { key="dialog_choices", text0="$T.back", text1="$T.gotitle", text2="$T.exitgame", backop=2 });
		menu_main?.action( "lighten");
		switch( ret){
		case 1:
			playSound( "SE011");
			::fadeoutBGM( 1000);
			RPGMain.showUI( { key="wipe", show="show", wait=1});
			sleep( 500);
			RPGMain.goTitle();
			return false;
		case 2:
			playSound( "SE011");
			::fadeoutBGM( 1000);
			RPGMain.showUI( { key="wipe", show="show", wait=1});
			sleep( 500);
			skExit( 0);
			return false;
		default:
			playSound( "SE004");
			break;
		}
		return true;
	}
};

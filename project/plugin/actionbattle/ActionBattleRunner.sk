// RPG-Cobo標準のバトル開始・終了処理にアクションバトルを接続するランナーです。

import VirtualKeyCode;
import ModifiersMask;

// 모델의 본 위치가 아닌 로컬 바운딩 박스의 정중앙을 화면 좌표로 투영한다.
class ActionBattleLockView extends RPG3DPopupView
{
	function updateFunc(dt){
		if( !rp3d) return true;
		if( !rp3d.alive){
			removeFromParent();
			return false;
		}

		local cam = parent.renderer.camera;
		local b = rp3d.bnd;
		local p = Vector3D(b.x, b.y, b.z).transform(rp3d.mat);
		local w = p.transform(cam.viewmat).transformw(cam.prjmat);
		pos(p.x, p.y, 0.0).scale(0.5/w, -0.5/w, 1.0).add(0.5, 0.5, 0.0).scale(parent.bnd.w, parent.bnd.h, 1.0).add(toffs);
		matdirty = true;
		layerflags |= 1;
		repaint();
		return true;
	}
}

// 操作キャラクターの位置を滑らかに追従するアクションバトル専用カメラ。
class ActionBattleCamerawork extends RPGCamerawork
{
	target3D = null;
	focus = null;
	yaw = Math.PI * 0.25;
	pitch = 35.0 * Math.DTOR;
	lockPitch = 22.0 * Math.DTOR;
	freeZoom = 8.0;
	lockZoom = 7.2;
	lockTarget3D = null;
	lockTransitionTime = 320.0;
	lockTransitionElapsed = 0.0;
	lockStartYaw = 0.0;
	lockStartPitch = 0.0;
	lockStartZoom = 8.0;
	lockStartFocus = null;
	renderedPitch = 35.0 * Math.DTOR;

	constructor(target){
		target3D = target;
		focus = Vector3D(target.pos).add(0.0, 1.0, 0.0);
		yaw = target.dir;
		hpb(yaw, pitch, 0.0);
		fovy = 40.0;
		zoom = freeZoom;
		renderedPitch = pitch;
		lockStartFocus = Vector3D(focus);
	}

	function updateBody(stage, dt){
		if( !target3D) return;
		local desired = Vector3D(target3D.pos).add(0.0, lockTarget3D ? 0.85 : 1.0, 0.0);
		if( lockTarget3D && lockTransitionElapsed < lockTransitionTime){
			lockTransitionElapsed = Math.min(lockTransitionElapsed + dt, lockTransitionTime);
			local t = lockTransitionElapsed / lockTransitionTime;
			local w = t*t*(3.0-2.0*t);
			focus(lockStartFocus).add(Vector3D(desired).sub(lockStartFocus).scale(w));
			yaw = unitdir(lockStartYaw + deltadir(lockStartYaw, target3D.dir) * w);
			renderedPitch = Math.lerp(lockStartPitch, lockPitch, w);
			zoom = Math.lerp(lockStartZoom, lockZoom, w);
		}else{
			local follow = Math.min(dt * 0.008, 1.0);
			focus.add(Vector3D(desired).sub(focus).scale(follow));
			// カメラの向きを操作キャラクターと一致させ、常に背後から映す。
			yaw = target3D.dir;
			renderedPitch = lockTarget3D ? lockPitch : pitch;
			zoom = lockTarget3D ? lockZoom : freeZoom;
		}
		to(focus);
		hpb(yaw, renderedPitch, 0.0);
	}

	function addPitch(delta){
		pitch = Math.clamp(pitch + delta, 10.0 * Math.DTOR, 70.0 * Math.DTOR);
	}

	function setLockTarget(target){
		if( target){
			lockStartYaw = yaw;
			lockStartPitch = renderedPitch;
			lockStartZoom = zoom;
			lockStartFocus = Vector3D(focus);
			lockTransitionElapsed = 0.0;
		}
		lockTarget3D = target;
		if( !target){
			renderedPitch = pitch;
			zoom = freeZoom;
		}
	}

	function recover(stage){
		if( target3D) focus(target3D.pos).add(0.0, 1.0, 0.0);
		update(stage, 1);
	}
}

class ActionBattleRunner extends BattleRunnerBase
{
	ended = false;
	elapsed = 0.0;
	minimumBattleTime = 1500.0;
	moveSpeed = 4.0;
	turnSpeed = 2.6;
	controlledMember = null;
	controlled3D = null;
	controlledCoreId = 1;
	isMoving = false;
	followCamera = null;
	cameraDragActive = false;
	lastMouseY = 0;
	lockedEnemy3D = null;
	lockOrder = null;
	lockIndex = -1;
	lockIcons = null;
	lockInfoView = null;

	function bindActionBattleMember( player){
		local data = ::bindMemberList(player);
		data["mhp"] <- data.maxhp;
		data["mmp"] <- data.maxmp;
		data["level.P"] <- data.lv;
		data["level.p"] <- data.lv;
		data["cha_preview"] <- player;

		// HP/MP 비율을 UI 애니메이션의 0(empty)~10(full) 프레임으로 변환한다.
		local hpframe = @() player.MAXHP>0
			? Math.clamp(Math.iceil(player.HP*10.0/player.MAXHP), 0, 10)
			: 0;
		local mpframe = @() player.MAXMP>0
			? Math.clamp(Math.iceil(player.MP*10.0/player.MAXMP), 0, 10)
			: 0;
		data["_white_HP"] <- hpframe;
		data["_white_MP"] <- mpframe;
		data["HP_BAR"] <- hpframe;
		data["MP_BAR"] <- mpframe;
		data["MP_BAR\\"] <- mpframe;
		return data;
	}

	function lockActionBattleMemberLayout( view){
		// 멤버 카드는 실행 중 크기를 변경하지 않으므로 에디터의 고정 좌표를 유지한다.
		view.stretchalign = 0;
		view.alignpos = null;
		view.stretchsize = null;
		view.bindrect = null;
		foreach( child in view.children){
			lockActionBattleMemberLayout(child);
		}
	}

	function bindActionBattleMemberSlot( listname, player){
		local slot = battleui.findChild(listname);
		if( !slot) return;
		if( !player){
			slot.setVisible(false);
			return;
		}

		// RPGListView의 런타임 행 스트레치를 사용하지 않고, 편집한 멤버 UI를
		// 슬롯 위치에 원본 크기 그대로 배치한다.
		local parent = slot.parent;
		local layer = parent.children.indexOf(slot);
		local memberui = ::loadSKView("/resource/ui/actionbattleui_member.ui");
		memberui.name = listname;
		lockActionBattleMemberLayout(memberui);
		memberui.pos.set(
			slot.pos.x + slot.bnd.x + (slot.bnd.w-memberui.bnd.w)*0.5 - memberui.bnd.x,
			slot.pos.y + slot.bnd.y + (slot.bnd.h-memberui.bnd.h)*0.5 - memberui.bnd.y,
			slot.pos.z
		);
		local charapreview = memberui.findChild("cha_preview");
		if( charapreview){
			// pbr_draft shares the stage target, which causes stale depth when
			// its background is disabled and black UI when a transparent
			// background is drawn into the active target. pbr_fw owns a color
			// and depth buffer, so it can be composited transparently.
			charapreview.renderer.setEnvironment(
				::RenderSettings.getEnvironment("pbr_fw")
			);
			charapreview.renderer.bgpass.enabled = false;
		}
		local data = bindActionBattleMember(player);
		memberui.bindValues(data);
		// CharaPreview owns a separate animated 3D scene.
		if( charapreview && charapreview.rp3d){
			charapreview.rp3d.rpgobj = player;
			charapreview.rp3d.anime2({ id = "stand" });
			charapreview.rp3d.updateMotion(0, true);
			charapreview.rp3d.updatePartsVisibles();
		}
		parent.setChild(layer, memberui);
	}

	// 액션배틀 전용 UI를 배틀 장면의 하단 UI 레이어에 표시한다.
	function setupBattleUI(){
		battleui = ::RPGMain.showView({
			uipath = "actionbattleui.ui"
			name = "battleui"
			layer = "stageui"
			pos = { bottom = 0 }
		});
		battleui.setVisible(true);
		battleui.findChild("infog")?.setVisible(false);

		// 세 명 파티 HUD: 조작 리더는 중앙, 나머지 멤버는 좌우에 배치한다.
		local sideMembers = [];
		foreach( member in members){
			if( member && member != controlledMember) sideMembers .. member;
		}
		bindActionBattleMemberSlot("left_member", sideMembers.len()>0 ? sideMembers[0] : null);
		bindActionBattleMemberSlot("main_member", controlledMember);
		bindActionBattleMemberSlot("right_member", sideMembers.len()>1 ? sideMembers[1] : null);

		battleui.findChild("enemylist")?.setVisible(false);
		battleui.findChild("cmdlist")?.setVisible(false);
		battleui.findChild("skilllist")?.setVisible(false);
		battleui.findChild("descpop")?.setVisible(false);
	}

	// 通常の2Dエネミーモデルの代わりにCV033ボクセルキャラクターを生成する。
	function addBattleEnemy(ec){
		local rp3d = RPG3DObject.create3DObject({mdlid="CV033"});
		rp3d.rpgobj = ec;
		rp3d.manuaction = ManualMoveAction(rp3d);
		stage.scn.addObject(rp3d);
		enemies .. ec;
		charas .. ec;
		chara3ds .. rp3d;

		local tgtview = ::loadSKView("/resource/ui/parts/target.ui", RPG3DTargetView);
		tgtview.name = "target"..ec;
		tgtview.setTarget(rp3d);
		tgtview.setVisible(false);
		stage.view3d.addChild(tgtview);
		rp3d.tgtview = tgtview;
		rp3d.anime2({id="stand"});

		// アクションバトルのロックオン専用アイコン。
		// 画面上の固定オフセットではなく、3Dモデルのバウンディングボックス中央を追従する。
		local lockicon = ::loadSKView("/resource/ui/pop_search.ui", ActionBattleLockView);
		lockicon.name = "actionbattle_lock_"..ec.dataid;
		lockicon.setTarget(rp3d);
		lockicon.setValue("lbl", RichText("[+12]\uf2c0[+0]"));
		// Material Icons 글리프의 시각 중심이 약간 오른쪽이라 6px 왼쪽으로 보정한다.
		lockicon.toffs = Vector3D(-6.0, 0.0, 0.0);
		lockicon.setVisible(false);
		stage.view3d.addChild(lockicon);
		lockIcons .. { target=rp3d, icon=lockicon };
		return rp3d;
	}

	function start(st){
		super.start(st);
		ended = false;
		elapsed = 0.0;
		lockIcons = [];
		lockInfoView = null;
		RPGMain.buttonhelp("battle");
		setupCharas();

		local enemyList = battledata["enemies"] || [];
		local enemy = enemyList[0];
		local enemyId = enemy?.id ?? "E000";
		local partyLeader = ::rpgstat.getPartyLeader();
		local leaderIndex = ::rpgstat.members.indexOf( partyLeader);
		if( leaderIndex<0 || leaderIndex>=4) leaderIndex = 0;
		local controlledPlayerId = leaderIndex + 1;
		controlledMember = partyLeader;
		controlled3D = getChara3D( partyLeader);
		controlledCoreId = controlledPlayerId;
		setupBattleUI();
		isMoving = false;
		followCamera = ActionBattleCamerawork(controlled3D);
		cameraDragActive = false;
		lastMouseY = 0;
		lockedEnemy3D = null;
		lockOrder = [];
		lockIndex = -1;
		local totalEnemyHp = 0.0;
		foreach(enemyInfo in enemyList){
			local enemyData = ::conf.enemy[enemyInfo.id];
			totalEnemyHp += enemyData?.MAXHP ?? 100.0;
		}
		if(totalEnemyHp <= 0.0) totalEnemyHp = 2000.0;
		::ActionBattleManager.start({
			enemyId = enemyId,
			enemyHp = totalEnemyHp,
			controlledPlayerId = controlledPlayerId,
		}, false);
		printf("[ActionBattle] Battle started. leader=%S slot=%d enemies=%d hp=%.1f\n",
			partyLeader?.dataid ?? "", leaderIndex, length(enemyList), totalEnemyHp);
	}

	function ensureFollowCamera(){
		if( !followCamera) return;
		// バトルマップの自動イベントが固定カメラへ戻しても追従カメラを優先する。
		if( stage.camwork != followCamera){
			stage.camfade = null;
			stage.camwork = followCamera;
			followCamera.recover(stage);
		}
	}

	// 右クリック中のマウス上下移動でカメラの高さ（ピッチ）を変更する。
	function updateCameraPitch(){
		if( !followCamera) return;
		// ロックオン中はキャラクター中心後方の固定ピッチを使う。
		if( lockedEnemy3D){
			cameraDragActive = false;
			return;
		}
		local mouse = ::rootview.mouses[0];
		local rightButtonDown = !!(mouse.modifiers & BUTTON2_MASK);
		if( !rightButtonDown){
			cameraDragActive = false;
			return;
		}

		if( !cameraDragActive){
			cameraDragActive = true;
			lastMouseY = mouse.mousey;
			return;
		}

		local dy = mouse.mousey - lastMouseY;
		lastMouseY = mouse.mousey;
		// 上へドラッグすると俯角を大きくしてカメラ位置を高くする。
		followCamera.addPitch(-dy * 0.005);
	}

	function getLockTargetsByDistance(){
		local targets = chara3ds.filter(@( v){
			return enemies.contains(v.rpgobj) && v.rpgobj && !v.rpgobj.isDead();
		});
		if( controlled3D){
			targets.sort(@( v) controlled3D.pos.hypot(v.pos));
		}
		return targets;
	}

	function showLockInfo(target){
		local monsterName = target.rpgobj.data?.name ?? target.rpgobj.dataid;
		if( lockInfoView){
			lockInfoView.bindValue("lbl", RichText(monsterName));
			return;
		}
		lockInfoView = ::RPGMain.showView({
			uipath = "actionbattleui_info_top.ui"
			name = "actionbattle_lock_info"
			layer = "info"
			pos = { top = 32 }
			binds = { lbl = RichText(monsterName) }
			action = "show"
		});
	}

	function hideLockInfo(){
		if( !lockInfoView) return;
		lockInfoView.actionAndDie("hide");
		lockInfoView = null;
	}

	function setTargetLock(target){
		foreach( v in chara3ds){
			if( enemies.contains(v.rpgobj)){
				// 標準ターゲット枠は使わず、指定されたアイコンだけを表示する。
				v.tgtview?.setVisible(false);
			}
		}
		foreach( item in lockIcons) item.icon.setVisible(item.target==target);
		lockedEnemy3D = target;
		followCamera?.setLockTarget(target);
		if( target){
			showLockInfo(target);
			// ロックオン補間中だけ弱いズームブラーを掛け、320msで解除する。
			stage.screenfx.screenEffectOn({
				sfxid="raster1", color=-1, num=1, pow=2.0, time=0, uv=(0.5,0.5)
			});
			stage.screenfx.screenEffectOff({sfxbits=2, time=320});
		}else{
			hideLockInfo();
		}
		::ActionBattleCore.director.lockOnTargetId = target ? target.rpgobj.dataid : -1;
		if( target){
			printf("[ActionBattle] Target locked. enemy=%S index=%d\n",
				target.rpgobj.dataid, lockIndex);
		}else{
			printf("[ActionBattle] Target lock released.\n");
		}
	}

	// TAB: 距離の近い順に敵を切り替え、最後の次はロックを解除する。
	function updateTargetLock(){
		if( !::ActionBattleManager.isActionPressedOnce("lockon")) return;

		if( !lockedEnemy3D){
			lockOrder = getLockTargetsByDistance();
			if( !length(lockOrder)){
				setTargetLock(null);
				return;
			}
			lockIndex = 0;
			setTargetLock(lockOrder[lockIndex]);
			return;
		}

		++lockIndex;
		if( lockIndex >= length(lockOrder)){
			setTargetLock(null);
			lockOrder = [];
			lockIndex = -1;
		}else{
			setTargetLock(lockOrder[lockIndex]);
		}
	}

	// 背後追従カメラ向け操作。W/Sで前後移動、A/Dでキャラクターを旋回する。
	function updateControlledMovement(dt){
		if( !controlled3D || ended) return;

		local turn = (::ActionBattleManager.isActionPressed("move_right") ? 1.0 : 0.0)
			- (::ActionBattleManager.isActionPressed("move_left") ? 1.0 : 0.0);
		local forward = (::ActionBattleManager.isActionPressed("move_up") ? 1.0 : 0.0)
			- (::ActionBattleManager.isActionPressed("move_down") ? 1.0 : 0.0);
		local dtsec = dt * 0.001;
		local movevec;

		if( lockedEnemy3D){
			// ロックオン中は敵を向いたまま、A/Dを左右ストレイフとして扱う。
			controlled3D.dir = aimdir(controlled3D.pos, lockedEnemy3D.pos);
			local len = Math.sqrt(turn*turn + forward*forward);
			if( len > 0.0){
				movevec = Vector3D(turn/len, 0.0, forward/len).rotate(controlled3D.dir, 0.0, 0.0);
			}
		}else{
			if( turn != 0.0) controlled3D.dir += turn * turnSpeed * dtsec;
			if( forward != 0.0)
				movevec = Vector3D(0.0, 0.0, forward).rotate(controlled3D.dir, 0.0, 0.0);
		}

		if( !movevec){
			if( isMoving) controlled3D.anime2({id="stand"});
			isMoving = false;
			return;
		}

		local oldx = controlled3D.pos.x, oldz = controlled3D.pos.z;
		controlled3D.move(movevec.scale(moveSpeed), dt, -0.4);
		controlled3D.anime2({id="dash"});
		isMoving = true;

		::ActionBattleCore.moveControlled(
			controlled3D.pos.x - oldx,
			controlled3D.pos.z - oldz);
	}

	function update(dt){
		if(ended) return;
		elapsed += dt;
		updateCameraPitch();
		ensureFollowCamera();
		updateTargetLock();
		local input = ::ActionBattleManager.processDebugInput();
		// アクションバトルの操作対象は常にパーティーリーダーに固定する。
		::ActionBattleCore.swapCharacter(controlledCoreId);
		updateControlledMovement(dt);
		local ret = ::ActionBattleManager.update(dt, input.dodge, input.burst);
		// Sakana에서는 !ret?.field의 연산 우선순위가 의도와 다르게 해석될 수 있다.
		if(!ret || !ret.isBattleFinished || elapsed < minimumBattleTime) return;

		ended = true;
		result = ret.hp > 0.0 ? 1 : -1;
		setTargetLock(null);
		printf("[ActionBattle] Battle ending. result=%d playerHp=%.1f enemyHp=%.1f elapsed=%.1fms\n",
			result, ret.hp, ret.enemyHp, elapsed);
		::ActionBattleManager.stop();
		endfunc(this);
	}
}

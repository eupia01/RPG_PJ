// ============================================================================
// 1. 초기화 및 리소스 로드
// ============================================================================

if (!skLoadAddon("action_battle_plugin")) { //[cite: 1, 5]
    println("Error: 액션 배틀 플러그인을 찾을 수 없습니다!");
}

local savedFieldState = {};
local isActionBattle = false;
local isResultScreen = false; 
local lockOnTargetId = -1;

local isSlowMotion = false;
local slowMotionTimer = 0.0;

local mainCamera = Camera(); //[cite: 6]
local particleSystem = ParticleGroup(); //[cite: 6]

// ============================================================================
// 2. 맵 전환 및 전투 라이프사이클
// ============================================================================

function onEncounterEnemy(enemyData) {
    savedFieldState.mapId = RPGStage.getCurrentMapId(); //[cite: 3]
    savedFieldState.playerX = player.x;
    savedFieldState.playerY = player.y;
    savedFieldState.playerZ = player.z;
    
    RPGStage.loadMap("BATTLE_MAP_ARENA"); //[cite: 3]
    Native_InitBattleScene();
    
    isActionBattle = true;
    isResultScreen = false;
    UI_ShowActionBattleHUD(true); 
}

function finishBattle() {
    isActionBattle = false;
    isResultScreen = false;
    UI_ShowActionBattleHUD(false);
    UI_HideBattleResult(); 
    
    RPGStage.loadMap(savedFieldState.mapId); //[cite: 3]
    player.setPosition(savedFieldState.playerX, savedFieldState.playerY, savedFieldState.playerZ);
}

// ============================================================================
// 3. 메인 업데이트 루프 (매 프레임 호출)
// ============================================================================

function update(dt) {
    if (!isActionBattle) {
        RPGMain.updateNormalField(dt); //[cite: 3]
        return;
    }

    if (isResultScreen) {
        if (skIsKeyPressed(KEY_ENTER)) { //[cite: 10]
            finishBattle(); 
        }
        return; 
    }

    local currentDt = dt;
    if (isSlowMotion) {
        currentDt = dt * 0.2; 
        slowMotionTimer -= dt; 
        if (slowMotionTimer <= 0.0) {
            isSlowMotion = false; 
        }
    }

    // --- 유저 입력 처리 ---
    if (skIsKeyPressed(KEY_TAB)) { //[cite: 10]
        local nextId = (player.id % 4) + 1; 
        Native_SwapCharacter(nextId);
    }
    if (skIsKeyPressed(KEY_1)) { //[cite: 10]
        Native_AddAggro(player.id, 30.0);
    }
    if (skIsKeyPressed(KEY_R3)) { //[cite: 10]
        lockOnTargetId = Native_ToggleLockOn();
    }
    if (skIsKeyPressed(KEY_P)) { //[cite: 10]
        Native_ApplyPoisonToPlayer();
    }
    
    local isDodgeInput = skIsKeyPressed(KEY_Q); //[cite: 10]
    local isBurstInput = skIsKeyPressed(KEY_V); // [NEW] 'V' 키로 버스트 연계기 발동![cite: 10]

    // --- C++ 코어 연산 호출 ---
    local result = Native_UpdateBattleScene(currentDt, isDodgeInput, isBurstInput);
    
    if (result != null) {
        
        // --- [NEW] 전투 종료 및 결과창 처리 ---
        if ("isBattleFinished" in result && result.isBattleFinished) {
            isResultScreen = true; 
            UI_ShowBattleResult(result.earnedRewards); 
            
            player.playAnimation("VICTORY_POSE");
            playSound("bgm_victory.ogg");
            return; 
        }

        // --- 1. 기본 UI 업데이트 ---
        if ("stamina" in result) UI_UpdateStaminaBar(result.stamina);
        if ("hp" in result) UI_UpdatePlayerHP(result.hp);
        if ("effectNames" in result) UI_UpdateStatusIcons(result.effectNames); 
        
        // 버스트 게이지 바 업데이트
        if ("burstGauge" in result) UI_UpdateBurstGauge(result.burstGauge);

        if ("partyAggro" in result && "enemyTargetId" in result) {
            UI_UpdateAggroChart(result.partyAggro, result.enemyTargetId);
        }

        // --- [NEW] 파티 연계기 (Chain Attack) 연출 ---
        if ("isChainAttackMode" in result && result.isChainAttackMode) {
            
            // 화면을 어둡게 하고 컷신 UI 테두리 활성화
            UI_EnableCutsceneMode(true); 

            // C++에서 새로운 스텝(다음 캐릭터 턴)으로 넘어간 바로 그 프레임일 때
            if ("eventChainStepStart" in result && result.eventChainStepStart) {
                // 연출할 캐릭터의 3D 객체를 가져옴 (가정)
                local actorId = result.chainStep; // 1:가디언, 2:파이터, 3:아처, 4:클레릭
                local actorObj = RPGObjects.getCharacter(actorId);
                
                // 캐릭터별 궁극기 고유 이펙트 및 애니메이션 재생
                if (actorId == 1) {
                    actorObj.playAnimation("ULTIMATE_SHIELD_BASH");
                    particleSystem.emit(actorObj.x, actorObj.y, actorObj.z, "EFE_BURST_EARTHQUAKE"); //[cite: 6]
                    playSound("se_voice_guardian_ult.wav");
                    UI_ShowCutsceneText("가디언: 방패의 심판!");
                } else if (actorId == 2) {
                    actorObj.playAnimation("ULTIMATE_SWORD_DANCE");
                    particleSystem.emit(actorObj.x, actorObj.y, actorObj.z, "EFE_BURST_SLASH_FLURRY"); //[cite: 6]
                    playSound("se_voice_fighter_ult.wav");
                    UI_ShowCutsceneText("파이터: 무한의 검제!");
                } else if (actorId == 3) {
                    actorObj.playAnimation("ULTIMATE_METEOR_BOW");
                    particleSystem.emit(actorObj.x, actorObj.y, actorObj.z, "EFE_BURST_METEOR_SHOWER"); //[cite: 6]
                    playSound("se_voice_archer_ult.wav");
                    UI_ShowCutsceneText("아처: 쏟아지는 유성!");
                } else if (actorId == 4) {
                    actorObj.playAnimation("ULTIMATE_HOLY_RAY");
                    particleSystem.emit(actorObj.x, actorObj.y, actorObj.z, "EFE_BURST_HOLY_PILLAR"); //[cite: 6]
                    playSound("se_voice_cleric_ult.wav");
                    UI_ShowCutsceneText("클레릭: 성스러운 빛이여!");
                }
            }
        } else {
            // 일반 전투 모드일 때 컷신 테두리 비활성화
            UI_EnableCutsceneMode(false);
        }

        // --- 3. 조작 캐릭터 일반 애니메이션 제어 ---
        if (!result.isChainAttackMode) {
            if ("isStunned" in result && result.isStunned) {
                player.playAnimation("STUNNED"); 
            } else if ("isDodging" in result && result.isDodging) {
                player.playAnimation("DODGE_SLIDE"); 
            }
        }

        // --- 4. 파티원 AI 행동 렌더링 (C++ 로그) ---
        if ("aiActions" in result && !result.isChainAttackMode) {
            foreach(actionLog in result.aiActions) { //[cite: 4]
                local srcPos = RPGObjects.getCharacterPos(actionLog.src);
                local targetPos = RPGObjects.getCharacterPos(actionLog.target);
                
                if (actionLog.action == "PROVOKE") {
                    particleSystem.emit(srcPos.x, srcPos.y + 2.0, srcPos.z, "EFE_PROVOKE_SHOUT"); //[cite: 6]
                    UI_ShowFloatingText(srcPos.x, srcPos.y + 10.0, srcPos.z, "Taunt!", 0xff0000ff);
                } else if (actionLog.action == "HEAL_MAGIC") {
                    particleSystem.emit(targetPos.x, targetPos.y, targetPos.z, "EFE_HEAL_CIRCLE"); //[cite: 6]
                    playSound("se_heal.wav");
                } else if (actionLog.action == "ATTACK_ARROW") {
                    particleSystem.emit(srcPos.x, srcPos.y, srcPos.z, "EFE_ARROW_SHOT"); //[cite: 6]
                } else if (actionLog.action == "ATTACK_MAGIC") {
                    particleSystem.emit(targetPos.x, targetPos.y, targetPos.z, "EFE_MAGIC_EXPLOSION"); //[cite: 6]
                } else if (actionLog.action == "ATTACK_POISON") {
                    particleSystem.emit(targetPos.x, targetPos.y, targetPos.z, "EFE_POISON_SLASH"); //[cite: 6]
                }
            }
        }

        // --- 5. 플레이어 피격/회피 피드백 연출 ---
        if ("eventPoisonTick" in result && result.eventPoisonTick) {
            particleSystem.emit(player.x, player.y + 5.0, player.z, "EFE_POISON_BUBBLE"); //[cite: 6]
            UI_ShowFloatingText(player.x, player.y + 15.0, player.z, "Poison!", 0x800080ff);
            playSound("se_poison_tick.wav");
        }
        
        if ("eventRegenTick" in result && result.eventRegenTick) {
            particleSystem.emit(player.x, player.y + 2.0, player.z, "EFE_HEAL_SPARKLE"); //[cite: 6]
            UI_ShowFloatingText(player.x, player.y + 15.0, player.z, "+Heal", 0x00ff00ff);
        }
        
        if ("eventJustDodge" in result && result.eventJustDodge) {
            particleSystem.emit(player.x, player.y, player.z, "EFE_JUST_DODGE"); //[cite: 6]
            playSound("se_just_dodge.wav");
            player.playAnimation("JUST_DODGE_COUNTER"); 
            
            isSlowMotion = true;
            slowMotionTimer = 1.5;
            println("저스트 회피 발동! 버스트 게이지 대폭 상승!");
        }
        
        if ("eventTookDamage" in result && result.eventTookDamage) {
            particleSystem.emit(player.x, player.y + 10.0, player.z, "EFE_HIT_BLOOD"); //[cite: 6]
            playSound("se_hit.wav");
            if (!("isStunned" in result && result.isStunned)) player.playAnimation("HURT"); 
        }

        // --- 6. 3D 카메라 렌더링 세팅 ---
        // C++이 넘겨준 카메라 벡터(camPos, lookAt)가 연계기 컷신 모드일 때는 주연 캐릭터 클로즈업 좌표로,
        // 평상시일 때는 플레이어 오프셋 좌표로 자동으로 들어오므로 그대로 세팅만 하면 됩니다.
        if (("camPos" in result && "lookAt" in result) && (lockOnTargetId != -1 || result.isChainAttackMode)) {
            mainCamera.lookAt(
                Vector3D(result.camPos[0], result.camPos[1], result.camPos[2]),
                Vector3D(result.lookAt[0], result.lookAt[1], result.lookAt[2])
            );
        } else {
            local mousePos = skGetMousePos([]); //[cite: 10]
            updateFreeCamera(mousePos[0], mousePos[1], mainCamera);
        }
        skSetCamera(mainCamera); //[cite: 6]

        // --- 7. 3D 파티클 엔진 업데이트 ---
        particleSystem.update(currentDt); //[cite: 6]
        skDrawParticleGroup(particleSystem); //[cite: 6]
    }
}

// ============================================================================
// 4. 기타 헬퍼 함수
// ============================================================================

function updateFreeCamera(mouseX, mouseY, cameraObj) {
    // 자유 시점 로직
}

function UI_ShowBattleResult(rewardsArray) {
    // SKView(GUI 시스템)를 이용한 리절트 화면[cite: 7]
    println("==== Battle Clear ====");
    println("획득 아이템:");
    foreach(item in rewardsArray) { //[cite: 4]
        println("- " + item);
    }
    println("엔터 키를 눌러 필드로 복귀하세요.");
}

function UI_HideBattleResult() {}
function UI_UpdateBurstGauge(value) {}
function UI_EnableCutsceneMode(enable) {}
function UI_ShowCutsceneText(text) {}
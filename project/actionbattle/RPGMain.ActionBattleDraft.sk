local isActionBattleActive = false;

// 1. 湲곗〈 ?꾪닾(?몄뭅?댄꽣) ?고쉶 濡쒖쭅
function onEnemyEncounter(enemyData) {
    // ---------------------------------------------------------
    // [湲곗〈 肄붾뱶 ?고쉶] ?붾㈃ ?꾪솚 諛??댁젣 ?꾪닾 吏꾩엯 濡쒖쭅 鍮꾪솢?깊솕
    // RPGSystem.startBattle(enemyData.id); 
    // ---------------------------------------------------------
    
    // ???C++ ?뚮윭洹몄씤???≪뀡 諛고? ?쒖옉 ?⑥닔 ?몄텧
    Native_StartActionBattle(player.id, enemyData.id);
    isActionBattleActive = true;
    
    // ?꾪닾 UI(泥대젰諛? ?ㅽ궗 ?듭뒳濡??? ?쒖떆
    UI_ShowActionBattleHUD(true); 

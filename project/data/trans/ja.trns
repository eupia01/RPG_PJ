		"dict":{},
		"enemy":{
			"E000":{"desc":"攻撃能力はほとんどないが、無限とも思われる耐久力を持つ。","name":"影人間"},
			"E001":{
				"desc":"洞窟や廃村に群れで住む小型の亜人。知能は低く力も弱いが狡猾で、罠や待ち伏せを好む。",
				"name":"ゴブリン"
			},
			"E002":{
				"desc":"草原に群れで暮らす温厚な魔獣。普段は草を食むだけだが、危険を感じると体毛に魔力を帯びさせ、静電気のような衝撃を放つ。",
				"name":"メリー"
			},
			"E003":{
				"desc":"巨大化した凶暴な蜂。森や花畑に巣を作り、縄張り意識が非常に強い。群れで襲うと冒険者でも危険。",
				"name":"キラービー"
			},
			"E004":{
				"desc":"暗い洞窟や廃墟に生息する大型のコウモリ。音波で周囲を探り、獲物を混乱させる。性格は臆病だが空腹時は凶暴化。",
				"name":"オオコウモリ"
			},
			"E005":{
				"desc":"湿地帯に住む魔力を帯びた巨大カエル。舌を伸ばして獲物を捕らえるほか、毒の粘液を飛ばす個体もいる。",
				"name":"フロッグ"
			},
			"E006":{
				"desc":"都市の下水や廃墟に群生する巨大化したネズミ。繁殖力が高く、群れで行動する。性格は凶暴で、病原菌を持つことも多い。",
				"name":"大ネズミ"
			},
			"E007":{
				"desc":"湿地や洞窟に発生する半液体生物。一見無害に見えるが、獲物を溶かす粘液で包み込む。物理攻撃が効きにくい。",
				"name":"スライム"
			},
			"E008":{
				"desc":"地中に巣を張る巨大蜘蛛。獲物を待ち伏せる習性があり、糸で動きを封じてから毒牙で仕留める。",
				"name":"ツチグモ"
			},
			"E009":{
				"desc":"森や山に住む粗暴な獣人。力が強く、集落を作って生活する。性格は好戦的で、弱者を見れば襲いかかる。",
				"name":"オーク"
			},
			"E010":{
				"desc":"魔力で動く骸骨の兵士。墓地や遺跡に出現し、命令に忠実に従う。感情はなく、痛みも感じない。",
				"name":"スケルトン"
			},
			"E011":{
				"desc":"湿った森や洞窟に群生する魔性のキノコ。胞子で仲間同士がゆるく繋がっており、危険を察知すると毒胞子を撒き散らす。",
				"name":"マッシュ"
			},
			"E012":{
				"desc":"森や山岳地帯に群れで暮らす獣。高い知能と連携力を持ち、リーダーの指示で獲物を追い詰める。",
				"name":"ウルフ"
			},
			"E013":{
				"desc":"湿地や湖畔に生息する巨大亀。分厚い甲羅でほとんどの攻撃を防ぎ、ゆっくりとした動きながらも縄張りに入る者には容赦しない。",
				"name":"トータス"
			},
			"E014":{
				"desc":"墓地や古代遺跡に漂う霊体。感情が薄く、ただ彷徨い続ける存在だが、強い魔力に引き寄せられる習性がある。",
				"name":"スピリット"
			},
			"E015":{
				"desc":"戦場に残った怨念が骨に宿り、戦士として蘇った存在。生前の戦闘技術をわずかに保持しており、錆びた剣や盾を巧みに扱う。",
				"name":"スカルファイター"
			},
			"E016":{
				"desc":"熱帯の川や湖に群れで生息する肉食魚。水中では驚異的な速度で動き、血の匂いに敏感。群れで獲物に噛みつき、瞬く間に肉を削り取る。",
				"name":"ピラニア"
			},
			"E017":{
				"desc":"魔力や呪いで蘇った死骸の犬。腐敗した体ながら俊敏で、狂暴性が増している。群れで襲われると非常に危険。",
				"name":"ゾンビドッグ"
			},
			"E018":{
				"desc":"荒野や街道に潜む人間の無法者。金品を狙って旅人を襲うが、戦闘力は個体差が大きい。危なくなるとすぐ逃げる臆病さも持つ。",
				"name":"盗賊"
			},
			"E019":{
				"desc":"草原や湿地に生息する大型の蛇。静かに獲物を待ち伏せ、素早い噛みつきで毒を注入する。温度変化に敏感で、夜間は動きが鈍る。",
				"name":"スネーク"
			},
			"E020":{
				"desc":"海を荒らす無法者の海賊。船上での戦闘に長け、斧や銃火器を扱う。粗暴で欲深いが、仲間意識は強い。",
				"name":"パイレーツ"
			},
			"E021":{
				"desc":"鉱山や洞窟に住む小柄な獣人。器用で道具作りが得意なため、罠や簡易武器を多用する。群れで行動すると急に強気になる",
				"name":"コボルド"
			},
			"E022":{
				"desc":"湿地帯や密林に咲く巨大な魔性の花。甘い香りで獲物を誘い寄せ、近づいた者に毒の花粉を浴びせる。周囲の生態系を支配する厄介な存在。",
				"name":"ラフレシア"
			},
			"E023":{
				"desc":"戦争で命を落とした兵士の怨念が鎧に宿った存在。生前の戦闘技術をわずかに保持しており、盾と剣を使った堅実な戦い方をする。",
				"name":"ソルジャー"
			},
			"E024":{
				"desc":"魔力に取り憑かれた魔族や魔法生物。知能が高く、遠距離から魔法弾や状態異常の呪文を放つ。",
				"name":"マジシャン"
			},
			"E025":{
				"desc":"墓地や戦場跡に現れる動く死体。腐敗しているため動きは鈍いが異常に打たれ強い。群れで現れると脅威が増す。",
				"name":"ゾンビ"
			},
			"E026":{
				"desc":"海岸や浅瀬に生息する巨大カニ。硬い甲殻で物理攻撃を弾き、鋭いハサミで挟みつける。縄張り意識が強く、近づく者には容赦しない。",
				"name":"クラブ"
			},
			"E027":{
				"desc":"山岳や荒野に住む巨体の獣人。怪力と耐久力に特に優れる。知能は低いが、怒りに任せた突進は凄まじい破壊力。",
				"name":"オーガ"
			},
			"E028":{
				"desc":"呪いで蘇った巨大カエル。腐敗した体から毒の粘液を垂れ流し病原菌を撒き散らすため、接近戦は非常に危険。",
				"name":"イビルフロッグ"
			},
			"E029":{
				"desc":"海底に潜む巨大ヒトデ型魔物。中心部を破壊しない限り再生し続ける生命力を持つ。触手のような腕で吸い付き、体力を吸収する。",
				"name":"イビルスター"
			},
			"E030":{
				"desc":"草原に群れで暮らす大型魔獣。温厚だが縄張りに入る者には突進で応戦する。その体当たりは凄まじく、地面を揺らすほどの威力。",
				"name":"バッファロー"
			},
			"E031":{
				"desc":"闇に紛れて生きる人型の暗殺者モンスター。森や廃寺などに潜み、気配を完全に消す能力を持つ。性格は冷酷で任務に忠実。",
				"name":"ニンジャ"
			},
			"E032":{
				"desc":"湿地帯や川辺に住む爬虫類型の亜人。集落を作り、独自の戦士文化を持つ。冷血で感情が読みにくいが、縄張りを侵す者には容赦しない。",
				"name":"リザードマン"
			},
			"E033":{
				"desc":"山岳地帯に生息する巨大な猛禽。鋭い視力で遠くの獲物を見つけ、急降下して鋭い爪で仕留める。性格は誇り高く、縄張り意識が強い。",
				"name":"イーグル"
			},
			"E034":{
				"desc":"魔力の高い地域に発生する知能型スライム。脳のような器官を持ち、精神干渉能力が強い。狡猾で、獲物の思考を乱して混乱させる。",
				"name":"ブレイン"
			},
			"E035":{
				"desc":"墓地や呪われた地に現れる死の化身。実体が薄く、鎌の一撃は魂そのものを削る。感情はなく、ただ死を運ぶ存在。",
				"name":"死神"
			},
			"E036":{
				"desc":"深海や魔力の強い湖に棲む巨大魚。鱗がドラゴンのように硬く、口から高圧の水流や小さな火花を吐く個体もいる。",
				"name":"ドラゴンフィッシュ"
			},
			"E037":{
				"desc":"海底洞窟に潜む巨大タコ。高い知能を持ち、岩陰に隠れて獲物を待ち伏せる。吸盤で絡め取り、強力な締め付けで動きを封じる。",
				"name":"オクトパス"
			},
			"E038":{
				"desc":"湿地帯や川辺に生息する巨大ワニ。水中では驚異的な速度で動き、陸上でも短距離なら素早い。獰猛な性格。",
				"name":"クロコダイル"
			},
			"E039":{
				"desc":"古い森の守護者として生まれた木製の巨人。魔力で動き、感情はほとんどないが森を守る本能が強い。",
				"name":"ウッドゴーレム"
			},
			"E040":{
				"desc":"海上に現れる歌声の魔物。美しい歌で船乗りを惑わせ、海へ誘い込む。性格は気まぐれで、興味を持った者だけを狙う。",
				"name":"セイレーン"
			},
			"E041":{
				"desc":"古代遺跡や城の屋根に潜む石像魔獣。昼は完全に石化して動かず、夜になると魔力で活動を始める。",
				"name":"ガーゴイル"
			},
			"E042":{
				"desc":"深い森に生息する巨大熊。普段は温厚だが、縄張りに入る者には激しい怒りを見せる。冬眠前は特に凶暴化する。",
				"name":"グリズリー"
			},
			"E043":{
				"desc":"砂漠の地中を泳ぐように移動する巨大虫型魔物。振動に敏感で、地表を歩く者を獲物と認識して襲いかかる。",
				"name":"ワーム"
			},
			"E044":{
				"desc":"聖なる森に住む神秘の獣。純粋な心を持つ者にしか姿を見せず、傷ついた者を癒す力を持つ。性格は高潔で誇り高い。",
				"name":"ユニコーン"
			},
			"E045":{
				"desc":"古い森の守護者として生まれた樹木の巨人。ゆっくりとした動きだが、怒らせると大地を揺らすほどの力を持つ。",
				"name":"トレント"
			},
			"E046":{
				"desc":"スライムの一種で、より柔軟性と跳躍力に優れたゼリー状生物。色によって性質が異なり、酸性・電気・冷気などの属性を持つ個体もいる。",
				"name":"ジェリー"
			},
			"E047":{
				"desc":"山岳地帯に巣を作る獅子と鷲の合成獣。誇り高く、縄張りに入る者には容赦しない。風を操る個体も存在する。",
				"name":"グリフォン"
			},
			"E048":{
				"desc":"満月の夜に変身する呪われた虎人間。普段は理性を保つが、変身時は獰猛で凶暴。俊敏な動きと鋭い爪による連撃が特徴。",
				"name":"ワータイガー"
			},
			"E049":{
				"desc":"呪われた蛇髪の魔族。洞窟や廃神殿に住み、侵入者を石化の視線で狩る。性格は孤独で執念深い。",
				"name":"メドゥーサ"
			},
			"E050":{
				"desc":"魔術によって動く巨大な岩の守護者。感情はなく、命令された範囲を黙々と守り続ける。物理攻撃に非常に強い。",
				"name":"ストーンゴーレム"
			},
			"E051":{
				"desc":"騎乗した魔装兵。荒野や古戦場に現れ、疾風のような速度で突撃してくる。性格は冷徹で、命令に忠実。",
				"name":"ホースナイト"
			},
			"E052":{
				"desc":"草原に君臨する獅子型魔獣。群れの頂点に立つ個体は特に強靭で、咆哮で周囲の敵を威圧する。性格は誇り高く、弱者を狙うことは少ない。",
				"name":"レオ"
			},
			"E053":{
				"desc":"迷宮や地下遺跡に棲む牛頭の巨人。怪力と耐久力に優れ、狭い通路でも突進してくる。性格は粗暴で、侵入者を見つけると怒り狂う。",
				"name":"ミノタウロス"
			},
			"E054":{
				"desc":"沼地や湖に潜む多頭の竜。頭を切り落としても再生する生命力を持つ。性格は獰猛で、縄張りに入る者を容赦なく襲う。",
				"name":"ヒュドラ"
			},
			"E055":{
				"desc":"深海に潜む巨大な海魔。船を沈めるほどの巨大触手を持ち、海流を操る力もある。性格は冷酷で、海上の振動に敏感。",
				"name":"クラーケン"
			},
			"E056":{
				"desc":"夜の城や廃屋に潜む吸血の魔族。高い知能と魅了の力を持ち、影のように動く。性格は冷静で狡猾。多彩な攻撃手段を持つ。",
				"name":"ヴァンパイア"
			},
			"E057":{
				"desc":"山岳や火山に棲む伝説級の魔獣。強靭な鱗と巨大な翼を持ち、爪、尾、ブレスの三拍子が揃った最強格。性格は誇り高く、侵入者には容赦しない。",
				"name":"ドラゴン"
			},
			"E058":{
				"desc":"古代の魔法器具に封じられた精霊。ランプをこすると現れ、強大な魔力を振るう。性格は気まぐれで、人間を試すような行動を取ることも。",
				"name":"魔人"
			},
			"E059":{
				"desc":"通常のドラゴンを遥かに凌ぐ古代種。大陸を揺るがすほどの力を持ち、空を飛ぶだけで嵐が起こる。性格は神に近いほど尊大。",
				"name":"グレートドラゴン"
			},
			"E060":{
				"desc":"深海の神格に近い魔物。巨大な魚人の姿を持ち、海底都市を支配する存在。性格は冷酷で、人間を獲物としか見ない。",
				"name":"ダゴン"
			}
		},
		"gvar":{
			"G000":{"name":"ぐろーばる000"},
			"G001":{"name":"ぐろーばる001"}

		"item":{
			"I000":{"desc":"役に立たないアイテム。","name":"こいし"},
			"I001":{"desc":"HP回復","name":"薬草"},
			"I004":{
				"desc":"一晩休んで味方全員のHP,MPを回復する。\n危険な場所では使えない。",
				"name":"テント"
			},
			"I010":{"desc":"HP回復","name":"ポーション"},
			"I011":{"desc":"HP回復","name":"ハイポーション"},
			"I016":{"desc":"HP回復","name":"蘇生薬"},
			"I018":{"desc":"毒を直す","name":"毒消し"},
			"I019":{"desc":"毒、麻痺、盲目、封印を直す。","name":"万能薬"},
			"I020":{"desc":"睡眠、混乱、魅了を直す。","name":"目覚ましベル"}
		},
		"job":{
			"J000":{
				"desc":"何の能力もない職業。ところが極めると色々有用な能力を習得できる。",
				"name":"村人"
			},
			"J001":{"desc":"選ばれたもののみが就くことが出来る特別な職業。","name":"勇者"},
			"J100":{"name":"正義感"},
			"J101":{
				"desc":"いかなる状況にも動じない鉄の心を持つ。\n精神系の状態異常に耐性が付く。",
				"name":"鉄の心"
			},
			"J102":{"desc":"弱った見方をかばう。","name":"騎士道"},
			"J103":{"name":"盗みの極意"},
			"J104":{"desc":"軽やかなステップで敵の攻撃をかわす。","name":"みかわしのステップ"},
			"J105":{"desc":"バトル開始時に攻撃力アップ。","name":"先手必勝"}
		},

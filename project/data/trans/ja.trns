		"player":{
			"P000":{
				"desc":"辺境の小村で育った心優しい青年。幼い頃に魔物から村を救われた経験から、強くなることを誓う。",
				"name":"シレン"
			},
			"P001":{
				"desc":"名門貴族の若き当主。気品と責任感を併せ持ち、腐敗した貴族社会を改革しようと志す。冷静だが情熱的な一面も。",
				"name":"アシュレイ"
			},
			"P002":{
				"desc":"王国軍の名門槍騎兵隊の家系に生まれたが、家を離れ傭兵や用心棒をしている。",
				"name":"キジー"
			},
			"P003":{
				"desc":"魔力の濃い森で生まれた天才魔術師。幼い頃から魔力が暴走しがちで、感情が力に直結する繊細な体質。",
				"name":"ミレイユ"
			},
			"P004":{
				"desc":"スラム街で育ち、幼い頃から身軽さと機転で生き延びてきた義賊。",
				"name":"カイ"
			},
			"P005":{
				"desc":"深い森に住む長命のエルフ族の娘。自然と精霊の声を聞く力を持ち、森の守護者として育てられた。",
				"name":"リーファ"
			},
			"P006":{
				"desc":"旅をしながら物語を紡ぐ吟遊詩人。港町の酒場で育ち、世界中の歌や伝承を学んできた。",
				"name":"ルード"
			},
			"P007":{
				"desc":"砂漠のオアシス都市で生まれた踊り子。幼い頃から舞と歌で旅人を魅了してきた。",
				"name":"フィオナ"
			},
			"P008":{
				"desc":"荒野の闘技場で育った孤児。自分を拾ってくれた師匠の教えを胸に、真の強さを求めて旅を続ける。",
				"name":"ランガ"
			},
			"P009":{
				"desc":"霧深い山里に隠れ住む忍びの一族の生まれ。任務のためならどんな危険にも身を投じるが、仲間を守るためには掟すら破ることもある。",
				"name":"シグレ"
			},
			"P010":{
				"desc":"王国を守る近衛騎士団の家系に生まれたエリート。厳格な性格だが、弱き者には誰よりも優しい。",
				"name":"クラリス"
			},
			"P011":{
				"desc":"行商人の家に生まれ、幼い頃から各地を旅してきた経験豊富な商人。利益だけでなく人との縁を大切にし、どんな相手とも誠実に取引する。",
				"name":"ロッシュ"
			},
			"P012":{
				"desc":"北方の森に住む小さな種族・コロボックルの青年。自然と共に生きる民で、植物や動物と心を通わせる力を持つ。",
				"name":"ポックル"
			}
		},

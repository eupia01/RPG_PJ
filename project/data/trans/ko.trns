				"name":"Villager"
			},
			"J001":{"desc":"A special occupation that only selected individuals can attain.","name":"Hero"},
			"J100":{"name":"Sense of justice"},
			"J101":{
				"desc":"Possesses an iron will that remains unshaken in any situation.\nYou gain resistance to mental status ailments.",
				"name":"Iron Heart"
			},
			"J102":{"desc":"To defend a weakened ally.","name":"chivalry"},
			"J103":{"name":"The Secrets of Stealing"},
			"J104":{"desc":"Dodges enemy attacks with light, nimble steps.","name":"Mikawashi no Step"},
			"J105":{"desc":"Attack power increases at the start of battle.","name":"first move wins"}
